# Todas las claves son opcionales: sin ellas, esa fuente de datos se omite y
# el resto del pipeline sigue funcionando (igual que ODDS_API_KEY en surebets).

# Finnhub (https://finnhub.io/register) — cotizaciones y noticias, tier gratuito.
FINNHUB_API_KEY=

# Reddit (https://www.reddit.com/prefs/apps -> crear app tipo "script") — menciones, tier gratuito.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sure-statistics/0.1 (personal, non-commercial)

# Twelve Data (https://twelvedata.com, registro gratis) — histórico de precio para el gráfico.
TWELVEDATA_API_KEY=

# Frankfurter (frankfurter.app) no necesita clave: tipo de cambio USD/EUR gratis y sin registro.
